{
  "name": "wiremock-testcontainers-nodejs-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone consumer project: imports @hellaweb3/wiremock-testcontainers-nodejs via npm link and runs end-to-end user-flow and WireMock-extension tests against a real WireMock container.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "link:library": "npm link @hellaweb3/wiremock-testcontainers-nodejs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-e2e.mjs",
    "test:e2e": "node scripts/test-e2e.mjs e2e",
    "test:unit": "vitest run extensions/ --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wiremock": "^3.13.2"
  },
  "engines": {
    "node": ">=22"
  }
}
