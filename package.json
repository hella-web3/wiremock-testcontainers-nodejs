{
  "name": "@hellaweb3/wiremock-testcontainers-nodejs",
  "description": "A Node.js library for using WireMock with Testcontainers, providing a fluent API for easy setup and integration testing.",
  "homepage": "https://github.com/hella-web3/wiremock-testcontainers-nodejs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hella-web3/wiremock-testcontainers-nodejs.git"
  },
  "bugs": "https://github.com/hella-web3/wiremock-testcontainers-nodejs/issues",
  "keywords": [
    "testcontainers",
    "wiremock",
    "testing",
    "mock",
    "api"
  ],
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Chris Anatalio",
  "files": [
    "dist",
    "!dist/*.js.map",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/index.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm run build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:coverage"
  },
  "dependencies": {
    "testcontainers": "^12.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "oxlint": "^1.87.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.22"
  }
}
