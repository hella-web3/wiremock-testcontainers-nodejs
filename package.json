{
  "name": "@hellaweb3/wiremock-testcontainers-nodejs",
  "description": "A Node.js library for using WireMock with Testcontainers, providing a fluent API for easy setup and integration testing.",
  "homepage": "https://hellalabs.dev/wiremock-testcontainers-nodejs/",
  "documentation": "https://hellalabs.dev/wiremock-testcontainers-nodejs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hella-labs/wiremock-testcontainers-nodejs.git"
  },
  "bugs": "https://github.com/hella-labs/wiremock-testcontainers-nodejs/issues",
  "keywords": [
    "testcontainers",
    "wiremock",
    "testing",
    "mock",
    "api"
  ],
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Chris Anatalio",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./no-docker": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:coverage": "vitest run --coverage",
    "build:extensions": "node scripts/build-extensions.mjs",
    "lint": "oxlint --deny-warnings --disable-nested-config",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm run build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:coverage",
    "examples:setup": "pnpm build && npm link && cd examples && npm install && npm run link:library",
    "examples:unit": "pnpm examples:setup && cd examples && npm run typecheck && npm run lint && npm run test:unit",
    "examples:e2e": "pnpm examples:setup && cd examples && npm run typecheck && npm run lint && npm test",
    "docs:start": "node scripts/docs.mjs",
    "docs:build": "node scripts/docs.mjs",
    "docs:serve": "node scripts/docs.mjs",
    "docs:api": "node scripts/docs.mjs",
    "docs:typecheck": "node scripts/docs.mjs",
    "docs:lint": "node scripts/docs.mjs",
    "docs:test:unit": "node scripts/docs.mjs",
    "docs:test:e2e": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs",
    "docs:sync:markdown": "node scripts/docs.mjs",
    "docs:version:cut": "node scripts/docs.mjs",
    "gate": "pnpm build && pnpm lint && pnpm typecheck && pnpm test:unit --coverage && pnpm test:e2e --no-docker && pnpm examples:e2e --no-docker && pnpm examples:unit --coverage",
    "gate:docker": "pnpm build && pnpm lint && pnpm typecheck && pnpm test:unit --coverage && pnpm test:e2e && pnpm examples:e2e && pnpm examples:unit --coverage"
  },
  "dependencies": {
    "testcontainers": "^12.2.0"
  },
  "peerDependencies": {
    "wiremock": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "wiremock": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.92.0",
    "publint": "^0.3.25",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wiremock": "^3.13.2"
  },
  "engines": {
    "node": ">=22.22"
  }
}
